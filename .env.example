ENABLE_URL_DISCOVERY=false
URL_DISCOVERY_BATCH_SIZE=50
URL_DISCOVERY_CONCURRENCY=5
URL_DISCOVERY_HTTP_TIMEOUT_S=10
URL_DISCOVERY_REQUEST_DELAY_S=0.5
URL_DISCOVERY_PROGRESS_LOG_EVERY=25
URL_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/url_discovery_checkpoint.json
ENABLE_OSM_DISCOVERY=false
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_DISCOVERY_TIMEOUT_S=30
OSM_DISCOVERY_REQUEST_DELAY_S=1.0
OSM_DISCOVERY_BATCH_SIZE=50
OSM_DISCOVERY_PROGRESS_LOG_EVERY=25
OSM_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/osm_discovery_checkpoint.json
OSM_MIN_MATCH_SCORE=0.65

# Shared extraction model for the search-API providers. NOT MISTRAL_MODEL: that is a
# reasoning model and would waste output tokens on a mechanical extraction.
EXTRACT_MODEL=ministral-8b-latest
EXTRACT_MAX_CHARS=20000
EXTRACT_HTTP_TIMEOUT_S=90
EXTRACT_HTTP_MAX_RETRIES=3
EXTRACT_RETRY_MAX_WAIT_S=30
EXTRACT_PRICE_IN=0
EXTRACT_PRICE_OUT=0
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Impressum probing. url_discovery's fetch_impressum returns homepages, so register numbers
# are missed (measured 0/8 vs 3/8 when the explicit paths are probed).
IMPRINT_PROBE_ENABLED=true
IMPRINT_PROBE_PATHS=/impressum/,/impressum,/imprint,/impressum.html
IMPRINT_PROBE_TIMEOUT_S=12
# Ceiling for an unverified LLM-read website: must stay under the resolver's 0.35 website
# threshold so a snippet guess never outranks page evidence.
LLM_WEBSITE_CONF_CAP=0.34

# Parallel Search MCP — free and works ANONYMOUSLY, key optional and only raises limits.
# Anonymous behaves like a hard quota of ~20 searches per process.
ENABLE_PARALLEL_SEARCH_DISCOVERY=false
PARALLEL_API_KEY=
PARALLEL_MCP_URL=https://search.parallel.ai/mcp
PARALLEL_MCP_TIMEOUT_S=120
PARALLEL_QUOTA_GIVEUP_AFTER=3
PARALLEL_MAX_CANDIDATES=5
PARALLEL_PROGRESS_LOG_EVERY=10
PARALLEL_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/parallel_search_discovery_checkpoint.json

# --- Exa search discovery ---------------------------------------------------------------
# Returns page contents with the search and reports costDollars per request, so it is the one
# provider whose spend is measured rather than estimated.
ENABLE_EXA_SEARCH_DISCOVERY=false
EXA_API_KEY=
EXA_API_BASE_URL=https://api.exa.ai
# instant | fast | auto | deep-lite | deep | deep-reasoning. NOT neural/keyword — those were
# removed from the enum and survive only as cost buckets in the response.
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=8
# highlights | text | both. Highlights are query-biased, so the Geschaeftsfuehrer line may not
# survive them; owner extraction may want text. Measure before changing.
EXA_CONTENT_MODE=highlights
EXA_TEXT_MAX_CHARS=4000
EXA_HTTP_TIMEOUT_S=45
EXA_HTTP_MAX_RETRIES=3
EXA_RETRY_MAX_WAIT_S=30
EXA_REQUEST_DELAY_S=0.15
EXA_MAX_CANDIDATES=5
EXA_PROGRESS_LOG_EVERY=10
EXA_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/exa_search_discovery_checkpoint.json

# --- Brave search discovery -------------------------------------------------------------
# Snippets only, no page text, so its LLM path has materially less to read than Exa's. The
# free Search plan grants $5/month of credits but signup requires a card on file.
ENABLE_BRAVE_SEARCH_DISCOVERY=false
BRAVE_API_KEY=
BRAVE_API_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_COUNTRY=DE
BRAVE_SEARCH_LANG=de
BRAVE_COUNT=10
BRAVE_HTTP_TIMEOUT_S=30
BRAVE_HTTP_MAX_RETRIES=3
BRAVE_RETRY_MAX_WAIT_S=30
BRAVE_REQUEST_DELAY_S=0.1
BRAVE_MAX_CANDIDATES=5
BRAVE_PROGRESS_LOG_EVERY=10
BRAVE_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/brave_search_discovery_checkpoint.json

