POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres
POSTGRES_PORT=5433
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
OVERPASS_PORT=12345
OVERPASS_MODE=init
OVERPASS_PLANET_URL=https://download.geofabrik.de/europe/germany/berlin-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.geofabrik.de/europe/germany/berlin-updates/
OVERPASS_SPACE=2000000000
NOMINATIM_PORT=8081
NOMINATIM_PASSWORD=nominatim
OUTPUT_FILE=/opt/airflow/data/gewerbedaten.jsonl
CHECKPOINT_FILE=/opt/airflow/data/gewerbedaten_checkpoint.json
RESET_CHECKPOINT=false
ADRESSEN_CACHE_FILE=/opt/airflow/data/adressen_cache.json
MAX_RECORDS=0
WFS_PAGE_SIZE=2000
WFS_START_INDEX=0
SKIP_GEOCODE=false
SKIP_NAME_LOOKUP=true
ADRESSEN_MAX_DIST_M=60
OVERPASS_URL=http://overpass/api/interpreter
ALLOW_PUBLIC_OVERPASS_FALLBACK=false
OVERPASS_RADIUS=80
OVERPASS_DELAY_S=1.5
OVERPASS_WORKERS=6
NAME_MATCH_MIN_SCORE=35
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_DELAY_S=2.0
DB_COMMIT_BATCH_SIZE=250
SOURCE_ENRICHMENT_BATCH_SIZE=50
# Process only companies the register still lists as aktiv. 56.4% of Osnabrück is erloschen or in
# Liquidation, and they yielded 4.0% of the websites — but turning this on changes which companies
# every stage sees, so measure before comparing against any number in docs/.
DISCOVERY_ACTIVE_ONLY=false
# Skip companies that already have a resolved website. Neither the per-source check nor the 0.90
# quality gate catches them: measured 2026-09-01, companies WITH a website averaged a quality score
# of 0.340, and 108 of 500 candidates (21.6%) already held one. Off while comparing providers on
# equal terms; on for production runs, where re-finding a known website is pure cost.
DISCOVERY_SKIP_RESOLVED_WEBSITE=false
ENABLE_BERLIN_GEWERBEDATEN_DAG=false
ENABLE_MISTRAL_SEARCH_DISCOVERY=false
ENABLE_CLAUDE_SEARCH_DISCOVERY=false
ENABLE_OLLAMA_SEARCH_DISCOVERY=false
MISTRAL_API_KEY=
MISTRAL_MODEL=magistral-small-2509
MISTRAL_SEARCH_TOOL=web_search
MISTRAL_DISCOVERY_MAX_RESULTS=5
MISTRAL_REQUEST_DELAY_S=1.0
MISTRAL_HTTP_TIMEOUT_S=45
MISTRAL_HTTP_MAX_RETRIES=3
MISTRAL_RETRY_MAX_WAIT_S=15
MISTRAL_PROGRESS_LOG_EVERY=5
MISTRAL_CONCURRENCY=4
MISTRAL_SUBMIT_DELAY_S=0.1
MISTRAL_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/mistral_search_discovery_checkpoint.json
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_WEB_SEARCH_TOOL_TYPE=web_search_20250305
CLAUDE_API_BASE_URL=https://api.anthropic.com/v1
CLAUDE_HTTP_TIMEOUT_S=45
CLAUDE_HTTP_MAX_RETRIES=5
CLAUDE_REQUEST_DELAY_S=3.0
CLAUDE_RETRY_MAX_WAIT_S=60
CLAUDE_MAX_TOKENS=1200
CLAUDE_WEB_SEARCH_MAX_USES=5
CLAUDE_MAX_PAUSE_TURNS=3
CLAUDE_DISCOVERY_MAX_RESULTS=5
CLAUDE_PROGRESS_LOG_EVERY=10
CLAUDE_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/claude_search_discovery_checkpoint.json
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# Ollama's OpenAI-compatible endpoint. Same server, different shape: it returns a `usage`
# block with token counts, which the native API does not, so scripts/ac_measurement.py uses
# this one to compare a local model against Mistral on equal terms. Point it at
# http://host.docker.internal:11434/v1 if you run Ollama on the host instead of the container.
OLLAMA_OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA_HTTP_TIMEOUT_S=120
OLLAMA_HTTP_MAX_RETRIES=3
OLLAMA_REQUEST_DELAY_S=0.0
OLLAMA_RETRY_WAIT_S=5.0
OLLAMA_PROGRESS_LOG_EVERY=10
OLLAMA_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/ollama_search_discovery_checkpoint.json
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_PORT=8888
SEARXNG_MAX_RESULTS=5
SEARXNG_TIMEOUT_S=15
SEARXNG_HTTP_MAX_RETRIES=3
SEARXNG_RETRY_WAIT_S=2.0
SEARXNG_REQUEST_DELAY_S=10.0
SEARXNG_SECRET=changeme_update_this
OLLAMA_PORT=11434
ENABLE_FOERDERKATALOG=false
ENABLE_MANAGER_NER=false
MANAGER_NER_MIN_COMPANIES=30
MANAGER_NER_EPOCHS=10
ENABLE_URL_DISCOVERY=false
URL_DISCOVERY_BATCH_SIZE=50
URL_DISCOVERY_CONCURRENCY=5
URL_DISCOVERY_HTTP_TIMEOUT_S=10
URL_DISCOVERY_REQUEST_DELAY_S=0.5
URL_DISCOVERY_PROGRESS_LOG_EVERY=25
URL_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/url_discovery_checkpoint.json
ENABLE_OSM_DISCOVERY=false
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_DISCOVERY_TIMEOUT_S=30
OSM_DISCOVERY_REQUEST_DELAY_S=1.0
OSM_DISCOVERY_BATCH_SIZE=50
OSM_DISCOVERY_PROGRESS_LOG_EVERY=25
OSM_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/osm_discovery_checkpoint.json
OSM_MIN_MATCH_SCORE=0.65

# Shared extraction model for the search-API providers. NOT MISTRAL_MODEL: that is a
# reasoning model and would waste output tokens on a mechanical extraction.
EXTRACT_MODEL=ministral-8b-latest
EXTRACT_MAX_CHARS=20000
EXTRACT_HTTP_TIMEOUT_S=90
EXTRACT_HTTP_MAX_RETRIES=3
EXTRACT_RETRY_MAX_WAIT_S=30
EXTRACT_PRICE_IN=0
EXTRACT_PRICE_OUT=0
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Impressum probing. url_discovery's fetch_impressum returns homepages, so register numbers
# are missed (measured 0/8 vs 3/8 when the explicit paths are probed).
IMPRINT_PROBE_ENABLED=true
IMPRINT_PROBE_PATHS=/impressum/,/impressum,/imprint,/impressum.html
IMPRINT_PROBE_TIMEOUT_S=12
# Ceiling for an unverified LLM-read website: must stay under the resolver's 0.35 website
# threshold so a snippet guess never outranks page evidence.
LLM_WEBSITE_CONF_CAP=0.34

# Put the Handelsregister number in the search query? Off, because it makes discovery worse.
# Measured on 100 Osnabrück companies: on = a provable website for 21, off = 25. Searching with
# the number finds MORE pages (17 companies with no usable result instead of 29) but they are
# register aggregators and directories, since those are the pages that quote register numbers.
# Does not affect the scorer, which still uses the number to confirm a downloaded page.
SEARCH_QUERY_INCLUDE_REGISTER_NUMBER=false

# Parallel Search MCP — free and works ANONYMOUSLY, key optional and only raises limits.
# Anonymous behaves like a hard quota of ~20 searches per process.
ENABLE_PARALLEL_SEARCH_DISCOVERY=false
PARALLEL_API_KEY=
PARALLEL_MCP_URL=https://search.parallel.ai/mcp
PARALLEL_MCP_TIMEOUT_S=120
PARALLEL_QUOTA_GIVEUP_AFTER=3
PARALLEL_MAX_CANDIDATES=5
PARALLEL_PROGRESS_LOG_EVERY=10
PARALLEL_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/parallel_search_discovery_checkpoint.json

# --- Exa search discovery ---------------------------------------------------------------
# Returns page contents with the search and reports costDollars per request, so it is the one
# provider whose spend is measured rather than estimated.
ENABLE_EXA_SEARCH_DISCOVERY=false
EXA_API_KEY=
EXA_API_BASE_URL=https://api.exa.ai
# instant | fast | auto | deep-lite | deep | deep-reasoning. NOT neural/keyword — those were
# removed from the enum and survive only as cost buckets in the response.
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=8
# highlights | text | both. Highlights are query-biased, so the Geschaeftsfuehrer line may not
# survive them; owner extraction may want text. Measure before changing.
EXA_CONTENT_MODE=highlights
EXA_TEXT_MAX_CHARS=4000
EXA_HTTP_TIMEOUT_S=45
EXA_HTTP_MAX_RETRIES=3
EXA_RETRY_MAX_WAIT_S=30
EXA_REQUEST_DELAY_S=0.15
EXA_MAX_CANDIDATES=5
EXA_PROGRESS_LOG_EVERY=10
EXA_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/exa_search_discovery_checkpoint.json

# --- Brave search discovery -------------------------------------------------------------
# Snippets only, no page text, so its LLM path has materially less to read than Exa's. The
# free Search plan grants $5/month of credits but signup requires a card on file.
ENABLE_BRAVE_SEARCH_DISCOVERY=false
BRAVE_API_KEY=
BRAVE_API_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_COUNTRY=DE
BRAVE_SEARCH_LANG=de
BRAVE_COUNT=10
BRAVE_HTTP_TIMEOUT_S=30
BRAVE_HTTP_MAX_RETRIES=3
BRAVE_RETRY_MAX_WAIT_S=30
BRAVE_REQUEST_DELAY_S=0.1
BRAVE_MAX_CANDIDATES=5
BRAVE_PROGRESS_LOG_EVERY=10
BRAVE_DISCOVERY_CHECKPOINT_FILE=/opt/airflow/data/brave_search_discovery_checkpoint.json

# --- Combined discovery (scripts/run_combined_discovery.py) -------------------------------
# Not a DAG and not driven by an ENABLE_ flag: a script that guesses domains, checks
# OpenStreetMap, and lets a LOCAL model judge the pages it downloaded. Costs no API money and
# writes nothing to the database. Choose stages with `--stages url,osm,judge`.
#
# Measured on 1000 Osnabrück companies: a website for 47 (4.7%), of which 38 `high`. About
# 2.4 hours wall clock at 4 workers. 69% of that time is the model, 29% page fetching, 3.5% DNS.
COMBINED_WORKERS=8
COMBINED_OUT_DIR=

# Domain guessing. 24 = 6 name shapes x 4 TLDs, and 536 of 1000 companies hit that cap.
# `.eu` and `.net` cost half the lookups and 236 page fetches per 1000 companies to produce 2
# winners out of 47 — kept anyway, because coverage is worth more here than 15% of runtime.
COMBINED_URL_TLDS=de,com,eu,net
COMBINED_URL_MAX_CANDIDATES=24
# 8, not 4. At 4 the cap bit 23 of 100 companies and 17 of those finished with no website while a
# live domain sat unopened. Fetching is the slow part, so this is the expensive knob.
COMBINED_URL_MAX_PROBES=8
COMBINED_URL_CONNECT_TIMEOUT_S=4
COMBINED_URL_HTTP_TIMEOUT_S=10
COMBINED_URL_MIN_STEM_LENGTH=4
# Guess `muller.de` and `müller.de` as well as `mueller.de`. Off: 28% of names carry an umlaut and
# all three spellings are live registrations, but on 100 companies the variants produced 5 fetched
# pages and no winner. The verification half is always on and is not behind this flag.
COMBINED_URL_UMLAUT_VARIANTS=false

# What counts as too common to identify one business, counted rather than listed.
COMBINED_COMMON_WORD_MIN=8
# Email domains shared by this many mapped businesses are a mail host, not a company. The most
# common one in Osnabrück is a LOCAL ISP used by 23 businesses, which no hand-written list of
# national providers would contain.
COMBINED_COMMON_EMAIL_DOMAIN_MIN=3

# OpenStreetMap, downloaded once for the city and matched offline. The bbox is OSNABRÜCK — the
# compose Overpass/Nominatim services are Berlin extracts, which is a separate thing.
COMBINED_OSM_BBOX=52.20,7.93,52.36,8.16
COMBINED_OSM_SNAPSHOT_MAX_AGE_DAYS=30
COMBINED_OSM_SNAPSHOT_TIMEOUT_S=300
COMBINED_OSM_QUERY_BY_CITY=true
COMBINED_OSM_MIN_MATCH_SCORE=0.65
COMBINED_OSM_STRONG_MATCH_SCORE=0.80
COMBINED_OSM_MIN_NAME_SIMILARITY=70
COMBINED_OSM_NO_DISTINCTIVE_MIN_SIMILARITY=95
COMBINED_OSM_PREFILTER_LIMIT=25

# The judge. Needs OLLAMA_* below and NO search engine — it only reads pages already downloaded.
# 6000 characters is load-bearing: at 3000 the model flipped 3 of 12 known verdicts, all from
# `own_site` to `unrelated`, including a page printing its own register number. It would be ~30%
# faster and measurably worse. Raising OLLAMA_NUM_PARALLEL does nothing on an integrated GPU.
COMBINED_LLM_JUDGE_MAX_CHARS=6000
COMBINED_LLM_JUDGE_MAX_OUTPUT_TOKENS=200
COMBINED_LLM_JUDGE_THINK=false

# Confidence. 0.35 is the platform's promotion bar; the two caps sit one notch under it so an
# unverified guess, or a page the model says belongs to somebody else, can never be promoted.
COMBINED_WEBSITE_MIN_CONFIDENCE=0.35
COMBINED_UNVERIFIED_CAP=0.34
# Without this cap, 5 of 11 promoted websites were pages the judge had explicitly rejected — a
# domain sales listing, a US haircare brand, a company in Ohio, a yacht charter, another winery.
COMBINED_NOT_OWN_SITE_CAP=0.34
# Let `llm_says_own_site` count as verifying evidence, which would let the model promote a page
# with no Impressum, no name and no postcode on its own. Only turn this on with numbers.
COMBINED_LLM_VERIFIES=false

# Starting confidence per method, and the weights for the model's opinion.
COMBINED_BASE_OSM=0.45
COMBINED_BASE_URL_PATTERN_MIN=0.20
COMBINED_BASE_URL_PATTERN_RANGE=0.25
COMBINED_BASE_LOCAL_LLM=0.15
COMBINED_W_OSM_EMAIL_DOMAIN=0.15
COMBINED_W_LLM_OWN_SITE=0.12
COMBINED_W_LLM_ABOUT_COMPANY=-0.15
COMBINED_W_LLM_UNRELATED=-0.20

# The SearXNG stage (`--stages llm`), distinct from the judge. It searches, and the engines
# SearXNG forwards to serve a CAPTCHA to office networks, so it finds nothing here.
COMBINED_SEARXNG_MAX_RESULTS=5
COMBINED_SEARXNG_SNIPPET_CHARS=300

